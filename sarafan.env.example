# This file is a part of the Sarafan application

COMPOSE_PROJECT_NAME=sarafan
SARAFAN_DEPLOYMENT_WAIT_TIMEOUT=180
SARAFAN_UI_IMAGE_TAG=latest
SARAFAN_BACKOFFICE_IMAGE=ghcr.io/sara-fan/sarafan.back.office
SARAFAN_BACKOFFICE_IMAGE_TAG=latest
SARAFAN_BACKOFFICE_PORT=8083
SARAFAN_BACKOFFICE_LOGGING_ENABLED=false
SARAFAN_CORE_IMAGE_TAG=latest
SW_CONSULTING_EDGE_NETWORK=sw-consulting-edge
SARAFAN_CERTIFICATE_DIR=/srv/sarafan/certificate
SARAFAN_POSTGRES_DATA_DIR=/srv/sarafan/postgres
SARAFAN_POSTGRES_DB=sarafan
SARAFAN_POSTGRES_USER=postgres
SARAFAN_POSTGRES_PASSWORD=replace-with-a-strong-database-password
SARAFAN_POSTGRES_PORT=5433
SARAFAN_ADMINER_PORT=8088
SARAFAN_JWT_SECRET=replace-with-at-least-32-random-characters
SARAFAN_BACKOFFICE_JWT_SECRET=replace-with-a-different-32-character-random-secret
# Enable only for the first migration run, obtain the credentials securely,
# then disable and remove both credential values.
SARAFAN_BACKOFFICE_BOOTSTRAP_ENABLED=false
SARAFAN_BACKOFFICE_BOOTSTRAP_EMAIL=
SARAFAN_BACKOFFICE_BOOTSTRAP_PASSWORD=
SARAFAN_REAL_PAYMENT_INTEGRATION_ENABLED=false
SARAFAN_UI_LOGGING_ENABLED=false
SARAFAN_BACKUP_DATA_DIR=/srv/sarafan/backup/data
SARAFAN_BACKUP_LOG_DIR=/srv/sarafan/backup/logs
SARAFAN_BACKUP_RETENTION_DAYS=7

# Quartz schedules. Quote cron expressions because this file is also sourced by Bash.
SARAFAN_EXCHANGE_RATES_CRON='0 10 0 * * ?'
SARAFAN_EXCHANGE_RATES_TIME_ZONE=Europe/Moscow
SARAFAN_EXCHANGE_RATES_RUN_ON_STARTUP=true
SARAFAN_CONSENT_RETENTION_CRON='0 0 1 * * ?'
SARAFAN_CONSENT_RETENTION_TIME_ZONE=Europe/Moscow
SARAFAN_CONSENT_RETENTION_RUN_ON_STARTUP=true
SARAFAN_IANA_TLD_UPDATE_CRON='0 0 3 5 * ?'
SARAFAN_IANA_TLD_UPDATE_TIME_ZONE=Europe/Moscow
SARAFAN_IANA_TLD_UPDATE_RUN_ON_STARTUP=false

# Optional OpenTelemetry OTLP export. Leave exporters as "none" when stdout is
# collected by the deployment, to avoid ingesting the same records twice.
OTEL_LOGS_EXPORTER=none
OTEL_TRACES_EXPORTER=none
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_RESOURCE_ATTRIBUTES=service.instance.id=sarafan-core-1
